# Server settings
PORT=
DEBUG=
DATABASE_URL=

# JWT Settings
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY_ROTATION_DAYS=365
# Private keys: только на клиенте (+ optional passphrase backup на сервере)

# Ollama / LLM (AI-помощник)
OLLAMA_BASE_URL=https://llm.oclinica.ru
OLLAMA_API_KEY=
# OLLAMA_API_KEY_HEADER=
# LLM_ADMIN_SECRET=your-admin-secret

# Web sockets
WS_HEARTBEAT_INTERVAL=30
WS_MESSAGE_QUEUE_SIZE=100
RATE_LIMIT_PER_MINUTE=60

# CORS Settings
CORS_ORIGINS=*

# Delivery: RabbitMQ + Redis presence (единственный режим)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
API_NODE_ID=api-1
REDIS_URL=redis://localhost:6380/0
INTERNAL_DELIVERY_SECRET=

# Novu (push). Self-host: см. deploy/novu/README.md
# Из контейнера api:
NOVU_API_URL=http://novu-api:3000
# Cloud вместо self-host:
# NOVU_API_URL=https://api.novu.co
NOVU_SECRET_KEY=
NOVU_PUSH_TRIGGER_IDENTIFIER=
# NOVU_FCM_INTEGRATION_IDENTIFIER=
NOVU_PUSH_APP_NAME=Kindred
